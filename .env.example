# =============================================================================
# بيت المصور — متغيرات البيئة
# انسخ إلى .env.local للتطوير:  cp .env.example .env.local
# على Railway: أضفها من Dashboard → Variables
# =============================================================================

# ── التطبيق ────────────────────────────────────────────────────────────────
# رابط التطبيق العام (محلياً أو نطاق Railway)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=بيت المصور

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# إلزامي في الإنتاج. ولّد سراً قوياً:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-generate-a-long-random-secret

# يُنصح به على Railway خلف بروكسي (Auth.js)
AUTH_TRUST_HOST=true

# ── PostgreSQL (Railway Postgres أو Docker) ────────────────────────────────
# فارغ محلياً = وضع Mock in-memory
# على Railway: اربط متغير DATABASE_URL من إضافة PostgreSQL
#
# Docker محلي:
# DATABASE_URL=postgresql://bayt:bayt@localhost:5432/bayt
#
# Railway عادة يوفّر شيئاً مثل:
# DATABASE_URL=postgresql://user:pass@host:5432/railway
#
# ملاحظة SSL: عميل pg في lib/db/postgres.ts يفعّل SSL تلقائياً لغير localhost
DATABASE_URL=

# ── Stripe (Test Mode) ─────────────────────────────────────────────────────
# مفاتيح وهمية للواجهة فقط — استبدلها من:
#   https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51DummyBaytAlMosawer2026SecretKeyForTestingOnly1234567890
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51DummyBaytAlMosawer2026PublishableKeyForTestingOnly123456
STRIPE_WEBHOOK_SECRET=whsec_DummyWebhookSecretForBaytAlMosawerTesting123456

# Price IDs من Products → Prices (Test Mode)
STRIPE_PRICE_ID_MONTHLY=price_1DummyMonthlyBayt2026
STRIPE_PRICE_ID_YEARLY=price_1DummyYearlyBayt2026

# (اختياري) أسعار خطط إضافية
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ── قديم / اختياري (غير مطلوب للتشغيل الحالي) ─────────────────────────────
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
