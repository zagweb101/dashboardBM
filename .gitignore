# =============================================================================
# بيت المصور — Git ignore
# =============================================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — لا ترفع أسراراً أبداً
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# اسمح برفع المثال فقط
!.env.example

# vercel / railway local
.vercel
.railway

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Desktop.ini

# images/videos generated locally (إن وُجدت)
/images/
/videos/

# sessions / temp
*.tmp
.cache/
